{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "love-arcade-server",
  "account_id": "133da2bd551cfcc3dd4e1a7aa9e10cd3",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "ArcadeRoom"
      },
      {
        "name": "CREATE_LIMITER",
        "class_name": "CreateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-sqlite-rooms",
      "new_sqlite_classes": [
        "ArcadeRoom",
        "CreateLimiter"
      ]
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://love-arcade-generated-by-ai.vercel.app,http://localhost:4173,http://127.0.0.1:4173"
  }
}